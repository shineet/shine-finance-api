# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
APP_TOKEN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional. Only set if it is a real https URL; otherwise Plaid ends on its
# own "all set" screen and the app finishes on next activation.
COMPLETION_REDIRECT_URI=
