{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/history",
      "destination": "/api/records?kind=history"
    },
    {
      "source": "/api/transactions",
      "destination": "/api/records?kind=transactions"
    },
    {
      "source": "/api/app-store-notifications",
      "destination": "/api/plaid-webhook?source=app-store"
    }
  ],
  "crons": [
    {
      "path": "/api/plaid-webhook?task=lapse",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/shortcuts/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Hey Aura.shortcut\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
